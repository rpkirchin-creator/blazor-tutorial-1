@page "/"

<PageTitle>Home</PageTitle>

<h1 class="home-page-title"> Welcome To Yet Another Blazor Offline Tutorial</h1>

<section class="home-hero">
    <div class="home-hero-content">
        <p>Welcome to Learn Blazor Applications.</p>
        <p>This project was coded using Copilot in Vscode </p>
        

        @* Show the tools learners should have ready before starting the tutorial. *@
        <section class="prerequisites" aria-labelledby="prerequisites-heading">
            <div class="prerequisites-heading">
                <h2 id="prerequisites-heading">Before You Begin</h2>
                <a class="btn btn-outline-light btn-sm" href="/learn#prerequisites">View prerequisites</a>
            </div>
            <p class="prerequisites-intro">Have these tools ready to follow along:</p>
            <ul class="prerequisite-list">
                <li>Visual Studio Code or another code editor</li>
                <li>.NET SDK installed (preferably the version used by this project)</li>
                <li>C# extension for VS Code</li>
                <li>Microsoft ASP.NET Core extension or Blazor tooling support</li>
                <li>Git installed for version control</li>
                <li>A browser for testing the app locally</li>
            </ul>
        </section>

        <div class="home-resources" aria-label="Learning resources">
            <a class="prerequisite-resource" href="https://blazorise.com/docs" target="_blank" rel="noopener noreferrer">
                <img src="/Blazorise.png" alt="" />
                https://blazorise.com/docs
            </a>
            <a class="prerequisite-resource" href="https://learn.microsoft.com/en-us/training/paths/build-apps-with-dotnet-maui/?utm_source=c-sharpcorner.com&amp;utm_medium=referral" target="_blank" rel="noopener noreferrer">
                <img src="/MSlearn.png" alt="" />
                Microsoft Learn
            </a>
        </div>
    </div>
</section>
