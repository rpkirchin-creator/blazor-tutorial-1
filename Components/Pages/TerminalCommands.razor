@page "/terminal-commands"
@rendermode InteractiveServer
@inject TerminalCommandStore CommandStore
@inject CommandRunner Runner

<PageTitle>Terminal Commands</PageTitle>

<h1 class="terminal-page-title">Terminal Commands</h1>
<p class="terminal-page-intro">Browse command examples by category. Commands run only in local Development profiles.</p>

<section class="card mb-4" aria-labelledby="command-runner-heading">
    <div class="card-body">
        <h2 id="command-runner-heading" class="h4">Choose a command</h2>
        @if (canRunCommands)
        {
            <p class="text-muted">
                Commands run on this computer, in the project folder, with the app's permissions.
                Review and confirm each command before it runs. Runs stop after 30 seconds.
            </p>
        }
        else
        {
            <div class="alert alert-info" role="status">
                Public tutorial mode: commands are examples only. Running, importing, and saving commands are disabled.
            </div>
        }

        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label for="command-category" class="form-label">Command type</label>
                <select id="command-category" class="form-select" @bind="selectedCategory" @bind:after="ChangeCategory">
                    @foreach (var category in TerminalCommandStore.Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label for="command-choice" class="form-label">Command</label>
                <select id="command-choice" class="form-select" @bind="selectedCommandId" @bind:after="SelectCommand">
                    <option value="">Choose a command...</option>
                    @foreach (var command in commands)
                    {
                        <option value="@command.Id">@command.Name</option>
                    }
                </select>
            </div>
        </div>
        @if (canRunCommands)
        {
            <div class="mt-3">
                <label for="import-command-category" class="form-label">Import commands as</label>
                <select id="import-command-category" class="form-select mb-2" @bind="importCategory">
                    <option value="Ubuntu">Ubuntu</option>
                    <option value="Windows PowerShell">Windows PowerShell</option>
                </select>
                <label for="command-csv-file" class="form-label">Choose a CSV file to import</label>
                <InputFile id="command-csv-file" OnChange="ImportCommands" accept=".csv,text/csv"
                           class="form-control" disabled="@isRunning" />
                <span class="form-text">CSV must contain newName, newDescription, and commandToRun columns. Maximum file size: 5 MB.</span>
            </div>
        }
        @if (canRunCommands && !string.IsNullOrWhiteSpace(importMessage))
        {
            <div class="alert @(importMessageIsError ? "alert-danger" : "alert-success") mt-3 mb-0"
                 role="status" aria-live="polite">
                @importMessage
            </div>
        }
        @if (canRunCommands)
        {
            <div class="row g-2 mt-1">
                <div class="col-12">
                    <label for="command-to-run" class="form-label">Command to run</label>
                    <div class="input-group">
                        <input id="command-to-run" class="form-control font-monospace" @bind="commandToRun"
                               maxlength="2000" placeholder="Select a command or type one" />
                        <button type="button" class="btn btn-primary" @onclick="() => PreviewCommand()" disabled="@isRunning">
                            Preview
                        </button>
                    </div>
                </div>
            </div>
        }
        @if (commands.FirstOrDefault(command => command.Id == selectedCommandId) is { } selectedCommand)
        {
            <p class="form-text mb-0">@selectedCommand.Description</p>
            @if (!canRunCommands)
            {
                <pre class="border rounded p-3 text-break"><code>@selectedCommand.Syntax</code></pre>
            }
        }

        @if (canRunCommands)
        {
            <details class="mt-3">
                <summary class="text-primary">Add a command to the list</summary>
                <form class="mt-3" @onsubmit="AddCommand" @onsubmit:preventDefault>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label for="new-command-category" class="form-label">Type</label>
                        <select id="new-command-category" class="form-select" @bind="newCategory">
                            @foreach (var category in TerminalCommandStore.Categories)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="command-name" class="form-label">Name</label>
                        <input id="command-name" class="form-control" @bind="newName" required maxlength="80" placeholder="List files" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="command-syntax" class="form-label">Command</label>
                        <input id="command-syntax" class="form-control font-monospace" @bind="newSyntax" required maxlength="500" placeholder="ls -la" />
                    </div>
                    <div class="col-12">
                        <label for="command-description" class="form-label">Description</label>
                        <textarea id="command-description" class="form-control" @bind="newDescription" required maxlength="500" rows="2" placeholder="Show all files, including hidden files."></textarea>
                    </div>
                </div>
                @if (canRunCommands && !string.IsNullOrWhiteSpace(formMessage))
                {
                    <p class="text-danger mt-2 mb-0" role="alert">@formMessage</p>
                }
                <button type="submit" class="btn btn-outline-primary mt-3">Save command</button>
                </form>
            </details>
        }

        @if (canRunCommands)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (!string.IsNullOrWhiteSpace(pendingCommand))
                {
                    <button type="button" class="btn btn-danger" @onclick="RunCommand" disabled="@isRunning">
                        @(isRunning ? "Running..." : "Confirm and run")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelCommand" disabled="@isRunning">
                        Cancel
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(pendingCommand))
            {
                <div class="alert alert-warning mt-3 mb-0" role="alert">
                    <strong>Review before running:</strong>
                    <pre class="mb-0 mt-2 text-break"><code>@pendingCommand</code></pre>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(runError))
            {
                <p class="text-danger mt-3 mb-0" role="alert">@runError</p>
            }

            @if (executionResult is not null)
            {
                <div class="mt-4" aria-live="polite">
                <h3 class="h6">
                    @if (executionResult.TimedOut)
                    {
                        <span>Stopped after the 30-second time limit</span>
                    }
                    else
                    {
                        <span>Finished with exit code @executionResult.ExitCode</span>
                    }
                </h3>
                @if (!string.IsNullOrWhiteSpace(executionResult.StandardOutput))
                {
                    <p class="mb-1 fw-semibold">Output</p>
                    <pre class="border rounded p-3 text-break"><code>@executionResult.StandardOutput</code></pre>
                }
                @if (!string.IsNullOrWhiteSpace(executionResult.StandardError))
                {
                    <p class="mb-1 fw-semibold">Errors</p>
                    <pre class="border border-danger rounded p-3 text-break"><code>@executionResult.StandardError</code></pre>
                }
                </div>
            }
        }
    </div>
</section>

@if (canRunCommands)
{
<section class="mt-4" aria-labelledby="command-history-heading">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 id="command-history-heading" class="h4 mb-0 terminal-page-title">Command history</h2>
        @if (history.Count > 0 && !confirmingHistoryClear)
        {
            <button type="button" class="btn btn-danger" @onclick="RequestHistoryClear" disabled="@isRunning">
                Clear history
            </button>
        }
    </div>
    <p class="terminal-page-intro">History is saved locally. Add an inverse command yourself; the app cannot safely guess how to undo a command.</p>
    @if (confirmingHistoryClear)
    {
        <div class="alert alert-warning" role="alert">
            <p class="mb-2">Clear all saved command history? This cannot be undone. Saved commands will not be deleted.</p>
            <button type="button" class="btn btn-danger me-2" @onclick="ClearHistory" disabled="@isRunning">
                Yes, clear history
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="CancelHistoryClear" disabled="@isRunning">
                Cancel
            </button>
        </div>
    }
    @if (history.Count == 0)
    {
        <p class="text-muted">Commands you run will appear here.</p>
    }
    else
    {
        <div class="d-grid gap-3">
            @foreach (var entry in history)
            {
                <article class="card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                            <time datetime="@entry.ExecutedAt.ToString("O")">@entry.ExecutedAt.ToLocalTime().ToString("g")</time>
                            @if (entry.Undone)
                            {
                                <span class="badge text-bg-success">Undo completed</span>
                            }
                            else if (entry.TimedOut)
                            {
                                <span class="badge text-bg-warning">Timed out</span>
                            }
                            else if (entry.ExitCode is int exitCode)
                            {
                                <span class="badge @(exitCode == 0 ? "text-bg-success" : "text-bg-danger")">Exit code @exitCode</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(entry.Error))
                            {
                                <span class="badge text-bg-danger">Could not run</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">In progress</span>
                            }
                        </div>
                        <pre class="border rounded p-3 text-break"><code>@entry.Command</code></pre>
                        @if (!string.IsNullOrWhiteSpace(entry.Error))
                        {
                            <p class="text-danger mb-3">@entry.Error</p>
                        }
                        @if (!entry.Undone && entry.UndoOfId is null)
                        {
                            <label for="undo-@entry.Id" class="form-label">Undo command you provide</label>
                            <textarea id="undo-@entry.Id" class="form-control font-monospace"
                                      @bind="undoDrafts[entry.Id]" rows="2" maxlength="2000"
                                      placeholder="Enter a command that reverses the effect, if appropriate."></textarea>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => SaveUndoCommand(entry.Id)" disabled="@isRunning">
                                    Save undo command
                                </button>
                                @if (!string.IsNullOrWhiteSpace(entry.UndoCommand))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            @onclick="() => PrepareUndo(entry)" disabled="@isRunning">
                                        Preview undo
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(historyMessage))
    {
        <p class="mt-2" role="status">@historyMessage</p>
    }
</section>
}

@code {
    private List<TerminalCommand> commands = [];
    private List<CommandHistoryEntry> history = [];
    private readonly Dictionary<string, string> undoDrafts = [];
    private string selectedCategory = TerminalCommandStore.Categories[0];
    private string selectedCommandId = "";
    private string newCategory = TerminalCommandStore.Categories[0];
    private string newName = "";
    private string newSyntax = "";
    private string newDescription = "";
    private string? formMessage;
    private string? importMessage;
    private string commandToRun = "";
    private string? pendingCommand;
    private string? pendingUndoForHistoryId;
    private string? runError;
    private string? historyMessage;
    private CommandExecutionResult? executionResult;
    private bool confirmingHistoryClear;
    private bool isRunning;
    private bool importMessageIsError;
    private string importCategory = "Ubuntu";
    private bool canRunCommands => Runner.CanExecute;

    protected override void OnInitialized()
    {
        LoadCommands();
        if (canRunCommands)
        {
            LoadHistory();
        }
    }

    private void LoadCommands()
    {
        commands = CommandStore.GetCommands(selectedCategory);
    }

    private void ChangeCategory()
    {
        LoadCommands();
        selectedCommandId = "";
        commandToRun = "";
    }

    private void SelectCommand()
    {
        commandToRun = commands.FirstOrDefault(command => command.Id == selectedCommandId)?.Syntax ?? "";
    }

    private void LoadHistory()
    {
        history = CommandStore.GetHistory();
        foreach (var entry in history)
        {
            undoDrafts[entry.Id] = entry.UndoCommand ?? "";
        }
    }

    private void RequestHistoryClear()
    {
        confirmingHistoryClear = true;
    }

    private void CancelHistoryClear()
    {
        confirmingHistoryClear = false;
    }

    private void ClearHistory()
    {
        if (!canRunCommands)
        {
            historyMessage = "Command history is unavailable outside Development.";
            return;
        }

        CommandStore.ClearHistory();
        history.Clear();
        undoDrafts.Clear();
        if (pendingUndoForHistoryId is not null)
        {
            pendingCommand = null;
            pendingUndoForHistoryId = null;
        }

        confirmingHistoryClear = false;
        historyMessage = "Command history cleared.";
    }

    private void AddCommand()
    {
        if (!canRunCommands)
        {
            formMessage = "Adding commands is unavailable outside Development.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newName) ||
            string.IsNullOrWhiteSpace(newSyntax) ||
            string.IsNullOrWhiteSpace(newDescription))
        {
            formMessage = "Enter a name, command, and description.";
            return;
        }

        CommandStore.AddCommand(newCategory, newName, newSyntax, newDescription);
        selectedCategory = newCategory;
        LoadCommands();
        selectedCommandId = commands.FirstOrDefault(command =>
            command.Name == newName.Trim() && command.Syntax == newSyntax.Trim())?.Id ?? "";
        SelectCommand();
        newName = "";
        newSyntax = "";
        newDescription = "";
        formMessage = null;
    }

    private async Task ImportCommands(InputFileChangeEventArgs args)
    {
        if (!canRunCommands)
        {
            importMessage = "Importing commands is unavailable outside Development.";
            importMessageIsError = true;
            return;
        }

        const long maxFileSize = 5 * 1024 * 1024;
        var file = args.File;
        importMessage = $"Importing {file.Name} as {importCategory}...";
        importMessageIsError = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (!string.Equals(Path.GetExtension(file.Name), ".csv", StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidDataException("Select a file with a .csv extension.");
            }

            await using var uploadStream = file.OpenReadStream(maxFileSize);
            using var stream = new MemoryStream();
            await uploadStream.CopyToAsync(stream);
            stream.Position = 0;

            var result = CommandStore.ImportCommands(stream, importCategory);
            selectedCategory = importCategory;
            LoadCommands();
            selectedCommandId = "";
            commandToRun = "";
            importMessage = result.ImportedCount == 0 && result.SkippedCount > 0
                ? $"{file.Name}: no new {importCategory} commands added; all {result.SkippedCount} commands were already in the database."
                : $"{file.Name}: imported {result.ImportedCount} {importCategory} commands; skipped {result.SkippedCount} duplicates.";
            importMessageIsError = false;
        }
        catch (IOException exception)
        {
            importMessage = $"Could not read {file.Name}: {exception.Message}";
            importMessageIsError = true;
        }
        catch (UnauthorizedAccessException exception)
        {
            importMessage = $"The app cannot access {file.Name}: {exception.Message}";
            importMessageIsError = true;
        }
        catch (InvalidDataException exception)
        {
            importMessage = $"{file.Name} is not a valid command CSV: {exception.Message}";
            importMessageIsError = true;
        }
        catch (Microsoft.VisualBasic.FileIO.MalformedLineException exception)
        {
            importMessage = $"{file.Name} contains a malformed CSV row: {exception.Message}";
            importMessageIsError = true;
        }
        catch (LiteDB.LiteException exception)
        {
            importMessage = $"Could not save commands from {file.Name}: {exception.Message}";
            importMessageIsError = true;
        }
    }

    private void PreviewCommand(string? undoOfId = null)
    {
        if (!canRunCommands)
        {
            runError = "Command execution is disabled outside Development.";
            return;
        }

        executionResult = null;
        runError = null;
        pendingUndoForHistoryId = undoOfId;
        pendingCommand = string.IsNullOrWhiteSpace(commandToRun)
            ? null
            : commandToRun.Trim();

        if (pendingCommand is null)
        {
            runError = "Enter a command to preview.";
        }
    }

    private void CancelCommand()
    {
        pendingCommand = null;
        pendingUndoForHistoryId = null;
        runError = null;
    }

    private void SaveUndoCommand(string id)
    {
        if (!canRunCommands)
        {
            historyMessage = "Command history is unavailable outside Development.";
            return;
        }

        if (!undoDrafts.TryGetValue(id, out var undoCommand) || string.IsNullOrWhiteSpace(undoCommand))
        {
            historyMessage = "Enter an undo command before saving it.";
            return;
        }

        CommandStore.SetUndoCommand(id, undoCommand);
        historyMessage = "Undo command saved. Review it before running.";
        LoadHistory();
    }

    private void PrepareUndo(CommandHistoryEntry entry)
    {
        if (entry.Undone || string.IsNullOrWhiteSpace(entry.UndoCommand))
        {
            historyMessage = "Save an undo command before preparing it.";
            return;
        }

        commandToRun = entry.UndoCommand;
        PreviewCommand(entry.Id);
    }

    private async Task RunCommand()
    {
        if (!canRunCommands)
        {
            runError = "Command execution is disabled outside Development.";
            return;
        }

        if (string.IsNullOrWhiteSpace(pendingCommand))
        {
            runError = "Preview and confirm a command before running it.";
            return;
        }

        var command = pendingCommand;
        var undoOfId = pendingUndoForHistoryId;
        var historyId = CommandStore.AddHistoryEntry(command, undoOfId);
        isRunning = true;
        runError = null;
        executionResult = null;

        try
        {
            var result = await Runner.RunAsync(command);
            CommandStore.CompleteHistoryEntry(historyId, result);
            executionResult = result;
            pendingCommand = null;
            pendingUndoForHistoryId = null;
            LoadHistory();
        }
        catch (ArgumentException exception)
        {
            RecordRunError(historyId, exception.Message);
        }
        catch (PlatformNotSupportedException exception)
        {
            RecordRunError(historyId, exception.Message);
        }
        catch (System.ComponentModel.Win32Exception exception)
        {
            RecordRunError(historyId, $"Could not start the command: {exception.Message}");
        }
        catch (IOException exception)
        {
            RecordRunError(historyId, $"Command execution failed: {exception.Message}");
        }
        catch (InvalidOperationException exception)
        {
            RecordRunError(historyId, exception.Message);
        }
        finally
        {
            isRunning = false;
        }
    }

    private void RecordRunError(string historyId, string message)
    {
        CommandStore.FailHistoryEntry(historyId, message);
        runError = message;
        LoadHistory();
    }
}
