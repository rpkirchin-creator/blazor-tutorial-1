@page "/code"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Code</PageTitle>

<section class="code-page">
    <div class="code-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="mb-1 code-page-title">Code</h1>
            <p class="mb-0 code-page-intro">Browse the app's components, services, startup code, and stylesheets.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-success" href="/download/source">Download Source</a>
            <button type="button" class="btn btn-primary" @onclick="PrintCode" disabled="@(selectedSource is null || loadError is not null)">
                Print / Save as PDF
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="alert alert-danger" role="alert">@loadError</div>
    }
    else if (sourceFiles.Count > 0 && selectedSource is not null)
    {
        <div class="code-toolbar mb-3">
            <label for="source-selector" class="form-label code-page-label">Select a source file</label>
            <select id="source-selector" class="form-select" @bind="selectedSourcePath" @bind:after="LoadSelectedSource">
                @foreach (var sourceFile in sourceFiles)
                {
                    <option value="@sourceFile.RelativePath">@sourceFile.DisplayName</option>
                }
            </select>
        </div>

        <article class="code-reader" aria-label="Selected page source code">
            <section class="code-section">
                <h2>Source: @selectedSource.DisplayName</h2>
                <pre><code>@sourceCode</code></pre>
            </section>
            <section class="code-section">
                <h2>@(selectedSource.StylesheetPath is null ? "Paired stylesheet" : $"Stylesheet: {Path.GetRelativePath(AppContext.BaseDirectory, selectedSource.StylesheetPath)}")</h2>
                @if (stylesheet is null)
                {
                    <p class="text-muted">This source file does not have an associated .razor.css stylesheet.</p>
                }
                else
                {
                    <pre><code>@stylesheet</code></pre>
                }
            </section>
        </article>
    }
</section>

@code {
    private readonly List<SourceFile> sourceFiles = [];
    private string? selectedSourcePath;
    private string? sourceCode;
    private string? stylesheet;
    private string? loadError;

    private SourceFile? selectedSource =>
        sourceFiles.FirstOrDefault(source => source.RelativePath == selectedSourcePath);

    protected override void OnInitialized()
    {
        // The project file copies these sources beside the app for build and publish.
        var appDirectory = AppContext.BaseDirectory;
        var componentsDirectory = Path.Combine(appDirectory, "Components");
        var servicesDirectory = Path.Combine(appDirectory, "Services");

        try
        {
            if (!Directory.Exists(componentsDirectory))
            {
                loadError = $"The component source files were not found at {componentsDirectory}.";
                return;
            }

            var componentFiles = Directory.GetFiles(componentsDirectory, "*.razor", SearchOption.AllDirectories);
            var serviceFiles = Directory.Exists(servicesDirectory)
                ? Directory.GetFiles(servicesDirectory, "*.cs", SearchOption.AllDirectories)
                : [];
            var additionalFiles = new[]
            {
                Path.Combine(appDirectory, "Program.cs"),
                Path.Combine(appDirectory, "BlazorApp1.csproj"),
                Path.Combine(appDirectory, "wwwroot", "app.css")
            };

            foreach (var filePath in componentFiles.Concat(serviceFiles).Concat(additionalFiles)
                         .Where(File.Exists)
                         .OrderBy(path => path, StringComparer.OrdinalIgnoreCase))
            {
                var relativePath = Path.GetRelativePath(appDirectory, filePath)
                    .Replace(Path.DirectorySeparatorChar, '/');
                var displayName = relativePath;
                var stylesheetPath = filePath.EndsWith(".razor", StringComparison.OrdinalIgnoreCase)
                    ? $"{filePath}.css"
                    : null;

                sourceFiles.Add(new SourceFile(relativePath, displayName, filePath, stylesheetPath));
            }

            if (sourceFiles.Count == 0)
            {
                loadError = $"No app source files were found under {appDirectory}.";
                return;
            }

            selectedSourcePath = sourceFiles[0].RelativePath;
            LoadSelectedSource();
        }
        catch (IOException exception)
        {
            loadError = $"Could not find the app source files under {appDirectory}: {exception.Message}";
        }
        catch (UnauthorizedAccessException exception)
        {
            loadError = $"The app cannot access source files under {appDirectory}: {exception.Message}";
        }
    }

    private void LoadSelectedSource()
    {
        var source = selectedSource;
        if (source is null)
        {
            loadError = "Select a source file to view its code.";
            return;
        }

        try
        {
            sourceCode = File.ReadAllText(source.FilePath);
            // Blazor's isolated stylesheet for Foo.razor is stored as Foo.razor.css.
            stylesheet = source.StylesheetPath is not null && File.Exists(source.StylesheetPath)
                ? File.ReadAllText(source.StylesheetPath)
                : null;
            loadError = null;
        }
        catch (IOException exception)
        {
            loadError = $"Could not read {source.DisplayName}: {exception.Message}";
        }
        catch (UnauthorizedAccessException exception)
        {
            loadError = $"The app cannot access {source.DisplayName}: {exception.Message}";
        }
    }

    private async Task PrintCode()
    {
        // The browser print stylesheet hides the controls and formats the selected source.
        await JS.InvokeVoidAsync("window.print");
    }

    private sealed record SourceFile(
        string RelativePath,
        string DisplayName,
        string FilePath,
        string? StylesheetPath);
}
