@page "/learn"
@rendermode InteractiveServer
@inject IJSRuntime JS
@using Markdig

<PageTitle>Learn Blazor</PageTitle>

<section class="learn-page">
    <div class="learn-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="mb-1 learn-page-title">Learn Blazor</h1>
            <p class="mb-0 learn-page-intro">Read the project guide here or print it to save as a PDF.</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="PrintGuide">
            Print / Save as PDF
        </button>
    </div>

    <section class="learning-resources mb-3" aria-labelledby="resources-heading">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 id="resources-heading" class="h4 mb-0">Learning Resources</h2>
            <button type="button"
                    class="btn btn-outline-primary"
                    aria-expanded="@showLearningResources"
                    aria-controls="learning-resources-viewer"
                    @onclick="ToggleLearningResources">
                @(showLearningResources ? "Hide PDF" : "View PDF")
            </button>
        </div>
        @if (showLearningResources)
        {
            <div id="learning-resources-viewer" class="resource-viewer mt-3">
                <iframe src="/Learning%20Resources.pdf"
                        title="Learning Resources PDF"
                        loading="lazy"></iframe>
                <p class="mt-2 mb-0">
                    If the PDF does not display here,
                    <a href="/Learning%20Resources.pdf" target="_blank" rel="noopener">open it in a new tab</a>.
                </p>
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="alert alert-danger" role="alert">@loadError</div>
    }
    else if (guideHtml is not null)
    {
        <article class="learn-reader" aria-label="Project learning guide">
            @((MarkupString)guideHtml)
        </article>
    }
</section>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline =
        new MarkdownPipelineBuilder().UseAutoIdentifiers().DisableHtml().Build();

    private string? guideHtml;
    private string? loadError;
    private bool showLearningResources;

    protected override void OnInitialized()
    {
        var guidePath = Path.Combine(AppContext.BaseDirectory, "README.md");

        try
        {
            guideHtml = Markdig.Markdown.ToHtml(File.ReadAllText(guidePath), MarkdownPipeline);
        }
        catch (IOException exception)
        {
            loadError = $"Could not read the learning guide at {guidePath}: {exception.Message}";
        }
        catch (UnauthorizedAccessException exception)
        {
            loadError = $"The app cannot access the learning guide at {guidePath}: {exception.Message}";
        }
    }

    private async Task PrintGuide()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void ToggleLearningResources()
    {
        showLearningResources = !showLearningResources;
    }
}
